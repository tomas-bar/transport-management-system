{
  "name": "krypta",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build --mode demo",
    "dev:browser": "vite --host 0.0.0.0 --port 4173",
    "build:browser": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:documents": "node --experimental-strip-types scripts/check-documents.ts",
    "data:seed": "node --experimental-strip-types scripts/data.ts seed",
    "data:clear": "node --experimental-strip-types scripts/data.ts clear",
    "data:export": "node --experimental-strip-types scripts/data.ts export",
    "build:server": "tsc -b && vite build --mode server",
    "dev:server": "vite --mode server --host 127.0.0.1 --port 5173 --strictPort",
    "server": "node --experimental-strip-types server/start.ts",
    "account:owner": "node --experimental-strip-types scripts/owner.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "build:sites": "node scripts/build-sites.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "esbuild": "^0.25.12"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
