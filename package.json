{
  "name": "krypta-tms",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:documents": "node --experimental-strip-types scripts/check-documents.ts",
    "build:local": "tsc -b && vite build --mode server",
    "local": "npm run build:local && node --experimental-strip-types server/index.ts",
    "server": "node --experimental-strip-types server/index.ts",
    "dev:local": "vite --mode server --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "leaflet": "^1.9.4",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/leaflet": "^1.9.16",
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
