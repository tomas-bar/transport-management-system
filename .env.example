# Copy to .env.local for Vite development only. No credentials belong in VITE_*.
# The server reads its configuration from the process environment.
# VITE_RUNTIME=server
# KRYPTA_PUBLIC_ORIGIN=http://127.0.0.1:4173
# KRYPTA_PORT=4174
# KRYPTA_HOST=127.0.0.1
# KRYPTA_DB_PATH=/absolute/private/path/server.sqlite
# NODE_ENV=production requires an HTTPS public origin and an HTTPS reverse proxy.
